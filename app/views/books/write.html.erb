<% content_for(:title, "Editor - #{@book.title}") %>

<div class="h-screen flex flex-col bg-[#F5F0EB]"
     data-controller="editor chapter-panel auto-save word-count publish editor-sidebar"
     data-editor-book-id-value="<%= @book.id %>"
     data-editor-chapter-id-value="<%= @active_chapter&.id %>"
      data-editor-chapter-title-value="<%= @active_chapter&.title %>"
      data-editor-content-value="<%= @active_chapter&.content %>"
     data-chapter-panel-book-id-value="<%= @book.id %>"
     data-chapter-panel-active-chapter-id-value="<%= @active_chapter&.id %>"
     data-auto-save-book-id-value="<%= @book.id %>"
     data-auto-save-chapter-id-value="<%= @active_chapter&.id %>"
     data-auto-save-debounce-ms-value="30000"
     data-publish-book-id-value="<%= @book.id %>"
      data-publish-book-title-value="<%= @book.title %>"
     data-publish-publishable-value="<%= @book.publishable? %>"
     data-publish-publish-url-value="<%= publish_book_path(@book) %>"
     data-publish-delete-url-value="<%= book_path(@book) %>"
     data-action="chapter:selected->editor#loadChapter
                 chapter:selected->editor-sidebar#close
                 beforeunload@window->auto-save#saveOnBeforeUnload
                 visibilitychange@document->auto-save#saveOnVisibilityChange">

  <header class="flex items-center justify-between px-4 py-3 bg-white border-b border-border-light">
    <div class="flex items-center gap-3">
      <%= link_to book_path(@book), class: "flex items-center gap-1 text-text-secondary hover:text-text-primary transition-colors text-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Voltar
      <% end %>
      <button type="button"
              data-editor-sidebar-target="toggle"
              data-action="click->editor-sidebar#toggle"
              aria-controls="chapter-sidebar"
              aria-expanded="false"
              aria-label="Abrir lista de capítulos"
              class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg text-text-secondary hover:text-text-primary hover:bg-[#C2A47E]/10 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
      </button>
      <div class="h-5 w-px bg-border-light"></div>
      <h1 class="text-lg font-serif font-semibold text-text-primary truncate max-w-md"><%= @book.title %></h1>
    </div>

    <div class="flex items-center gap-2">
      <% if @book.draft? %>
        <button data-action="click->publish#open"
                class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-[#8B7355] text-white text-sm font-medium rounded-lg hover:bg-[#7A6548] transition-colors hover:cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
          Publicar
        </button>
      <% else %>
        <%= button_to unpublish_book_path(@book), method: :patch,
            data: { turbo_confirm: "Despublicar este livro?", confirm_title: "Despublicar livro", confirm_accept: "Despublicar", confirm_variant: "danger" },
            class: "inline-flex items-center gap-1.5 px-3 py-1 bg-success/10 text-success text-sm font-medium rounded-full hover:bg-success/20 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Publicado
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="flex flex-1 overflow-hidden">
    <div data-editor-sidebar-target="overlay"
         data-action="click->editor-sidebar#closeMobile"
         class="hidden fixed inset-0 z-30 bg-black/50 lg:hidden"></div>

    <aside id="chapter-sidebar"
           data-editor-sidebar-target="sidebar"
           aria-label="Lista de capítulos"
           aria-hidden="true"
           class="invisible lg:visible fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-[#F5E6D3] border-r border-border-light transition-transform duration-200 ease-in-out lg:static lg:translate-x-0 lg:z-auto">
      <div class="flex items-center justify-between px-4 py-3 border-b border-border-light">
        <h2 class="text-sm font-medium text-text-primary">Capítulos</h2>
        <div class="flex items-center gap-1">
          <button data-action="click->chapter-panel#addChapter"
                  data-editor-sidebar-target="addButton"
                  class="flex items-center gap-1 text-xs text-[#8B7355] hover:text-[#7A6548] font-medium transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Novo
          </button>
          <button type="button"
                  data-action="click->editor-sidebar#closeMobile"
                  class="lg:hidden inline-flex items-center justify-center w-8 h-8 rounded-lg text-text-secondary hover:text-text-primary hover:bg-[#C2A47E]/10 transition-colors"
                  aria-label="Fechar lista de capítulos">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </div>

      <ul data-chapter-panel-target="list" class="flex-1 overflow-y-auto p-2 space-y-1">
        <% if @chapters.any? %>
          <% @chapters.each do |chapter| %>
            <li data-chapter-id="<%= chapter.id %>"
                data-position="<%= chapter.position %>"
                draggable="true"
                class="flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer transition-colors group
                       <%= chapter == @active_chapter ? 'bg-[#C2A47E]/10 border-l-3 border-[#C2A47E]' : 'hover:bg-[#C2A47E]/5' %>">
              <span class="text-text-muted text-sm chapter-number"><%= chapter.position + 1 %></span>
              <span class="flex-1 text-sm text-text-primary chapter-title truncate"><%= chapter.title %></span>
              <span class="text-xs text-text-muted chapter-word-count"><%= chapter.word_count %> pal.</span>
              <button class="opacity-0 group-hover:opacity-100 text-text-muted hover:text-error transition-opacity p-1"
                      data-action="click->chapter-panel#deleteChapter" title="Excluir capítulo">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </li>
          <% end %>
        <% else %>
          <li data-chapter-panel-target="emptyState" class="text-center py-8 text-text-muted text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2 opacity-50"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            <p>Nenhum capítulo ainda</p>
            <p class="text-xs mt-1">Clique em "+ Novo" para começar</p>
          </li>
        <% end %>
      </ul>
    </aside>

    <main class="flex-1 flex flex-col overflow-hidden">
      <div data-editor-target="toolbar" class="flex items-center gap-1 px-4 py-2 bg-white border-b border-border-light overflow-x-auto">
        <button data-action="click->editor#bold" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary font-bold text-sm" title="Negrito (Ctrl+B)">B</button>
        <button data-action="click->editor#italic" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary italic text-sm" title="Itálico (Ctrl+I)">I</button>
        <button data-action="click->editor#underline" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary underline text-sm" title="Sublinhado (Ctrl+U)">U</button>

        <div class="h-5 w-px bg-border-light mx-1"></div>

        <button data-action="click->editor#heading1" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary text-sm font-bold" title="Título 1">H1</button>
        <button data-action="click->editor#heading2" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary text-sm font-semibold" title="Título 2">H2</button>
        <button data-action="click->editor#heading3" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-primary text-sm font-medium" title="Título 3">H3</button>

        <div class="h-5 w-px bg-border-light mx-1"></div>

        <button data-action="click->editor#bulletList" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Lista">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
        </button>
        <button data-action="click->editor#orderedList" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Lista Ordenada">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="21" y1="6" y2="6"/><line x1="10" x2="21" y1="12" y2="12"/><line x1="10" x2="21" y1="18" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
        </button>
        <button data-action="click->editor#blockquote" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Citação">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 6H3"/><path d="M21 12H8"/><path d="M21 18H8"/><path d="M3 12v6"/></svg>
        </button>
        <button data-action="click->editor#horizontalRule" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Separador">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="2" x2="22" y1="12" y2="12"/></svg>
        </button>

        <div class="h-5 w-px bg-border-light mx-1"></div>

        <button data-action="click->editor#undo" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Desfazer (Ctrl+Z)">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
        </button>
        <button data-action="click->editor#redo" class="p-2 rounded hover:bg-bg-sec transition-colors text-text-secondary" title="Refazer (Ctrl+Y)">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"/></svg>
        </button>
      </div>

      <div data-editor-target="content" class="flex-1 overflow-y-auto bg-[#F5F0EB]">
      </div>

      <footer data-editor-target="statusBar" class="flex items-center justify-between px-4 py-2 bg-white border-t border-border-light text-xs text-text-muted">
        <div class="flex items-center gap-4">
          <span data-word-count-target="wordCount">0 palavras</span>
          <span data-word-count-target="charCount">0 caracteres</span>
        </div>
        <div class="flex items-center gap-4">
          <span data-save-status>Salvo automaticamente</span>
          <div class="h-4 w-px bg-border-light"></div>
          <button data-action="click->publish#openDeleteModal"
                  class="text-error hover:text-red-700 transition-colors font-medium hover:cursor-pointer">
            Excluir
          </button>
        </div>
      </footer>
    </main>
  </div>

  <%= render "publish_modal" %>
  <%= render "delete_modal" %>
</div>

<style>
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes slideUp {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-10px); }
  }
</style>
