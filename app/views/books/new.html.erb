<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-serif font-bold text-text-primary mb-6">Criar Novo Livro</h1>

  <div class="bg-bg-card rounded-xl border border-border-light shadow-sm p-6">
    <%= form_with model: @book, class: "space-y-6" do |f| %>
      <% if @book.errors.any? %>
        <div class="bg-error/10 border border-error/20 rounded-lg p-4">
          <h3 class="text-sm font-medium text-error">Ocorreu <%= @book.errors.count == 1 ? '1 erro' : "#{@book.errors.count} erros" %> ao salvar:</h3>
          <ul class="mt-2 list-disc list-inside text-sm text-error">
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :title, "Título", class: "block text-sm font-medium text-text-primary mb-2" %>
        <%= f.text_field :title, class: "w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors", placeholder: "Digite o título do livro" %>
      </div>

      <div>
        <%= f.label :author_name, "Nome do Autor", class: "block text-sm font-medium text-text-primary mb-2" %>
        <%= f.text_field :author_name, class: "w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors", placeholder: "Como deseja ser chamado" %>
      </div>

      <div>
        <%= f.label :description, "Sinopse", class: "block text-sm font-medium text-text-primary mb-2" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors resize-none", placeholder: "Uma breve descrição do livro" %>
      </div>

      <div>
        <%= f.label :category, "Categoria", class: "block text-sm font-medium text-text-primary mb-2" %>
        <%= f.select :category, Book.categories.keys.map { |c| [c.humanize, c] }, { include_blank: "Selecione uma categoria" }, class: "w-full px-4 py-2 border border-border rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary transition-colors" %>
      </div>

      <div data-controller="cover-upload">
        <label class="block text-sm font-medium text-text-primary mb-2">Capa do Livro</label>

        <input type="file"
               data-cover-upload-target="fileInput"
               accept="image/jpeg,image/png,image/webp"
               class="hidden"
               name="book[cover_image]"
               id="book_cover_image">

        <div data-cover-upload-target="dropZone"
             data-action="click->cover-upload#openFilePicker dragover->cover-upload#onDragOver dragleave->cover-upload#onDragLeave drop->cover-upload#onDrop"
             class="border-2 border-dashed border-border rounded-xl p-6 text-center cursor-pointer transition-colors hover:border-[#8B7355] hover:bg-[#C2A47E]/5">

          <div data-cover-upload-target="placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-text-muted">
              <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" x2="12" y1="2" y2="15"/>
            </svg>
            <p class="text-sm text-text-secondary font-medium">Arraste uma imagem ou clique para selecionar</p>
            <p class="text-xs text-text-muted mt-1">JPG, PNG ou WebP · Máximo 5MB · Proporção 2:3 (600x900px)</p>
          </div>

          <div data-cover-upload-target="previewContainer" class="hidden relative">
            <img data-cover-upload-target="preview" class="w-full max-w-[200px] mx-auto rounded-lg shadow-sm" alt="Preview da capa">
            <button type="button"
                    data-action="click->cover-upload#removeCover"
                    class="absolute top-2 right-[calc(50%-100px+8px)] p-1.5 bg-error text-white rounded-full hover:bg-error/90 transition-colors shadow-sm z-10"
                    title="Remover capa">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
          </div>
        </div>

        <p data-cover-upload-target="error" class="hidden text-xs text-error mt-2"></p>

        <div class="mt-4">
          <%= f.label :cover_color, "Cor de Fundo da Capa", class: "block text-sm font-medium text-text-primary mb-2" %>
          <div class="flex items-center gap-3">
            <%= f.color_field :cover_color, class: "w-12 h-10 border border-border rounded cursor-pointer" %>
            <span class="text-sm text-text-secondary">Usada quando não há imagem de capa</span>
          </div>
        </div>

        <input type="hidden" name="book[remove_cover]" value="">
      </div>

      <div class="flex items-center gap-4 pt-4">
        <%= f.submit "Criar Livro", class: "px-6 py-2.5 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium cursor-pointer" %>
        <%= link_to "Cancelar", dashboard_path, class: "px-6 py-2.5 text-text-secondary hover:text-text-primary transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
