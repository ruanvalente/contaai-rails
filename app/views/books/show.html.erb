<div class="max-w-4xl mx-auto">
  <div class="bg-bg-card rounded-xl border border-border-light shadow-sm overflow-hidden">
    <div class="md:flex">
      <div class="md:w-1/3 bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center min-h-[300px]">
        <% if @book.cover_image.attached? %>
          <%= image_tag @book.cover_image.variant(resize_to_fill: [400, 600]), class: "w-full h-full object-cover" %>
        <% else %>
          <div class="w-32 h-44 rounded shadow-lg flex items-center justify-center" style="background-color: <%= @book.cover_color %>">
            <span class="text-white text-3xl font-bold"><%= @book.title.first(2) %></span>
          </div>
        <% end %>
      </div>
      <div class="md:w-2/3 p-6 md:p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-serif font-bold text-text-primary"><%= @book.title %></h1>
            <p class="text-text-secondary mt-1">por <%= @book.author_name %></p>
          </div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
            <%= @book.published? ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning' %>">
            <%= @book.published? ? 'Publicado' : 'Rascunho' %>
          </span>
        </div>

        <div class="mt-4 flex items-center gap-4 text-sm text-text-muted">
          <span><%= @book.category.humanize %></span>
          <% if @book.average_rating > 0 %>
            <span class="text-warning">★ <%= @book.average_rating %> (<%= @book.ratings_count %> avaliações)</span>
          <% end %>
          <span><%= number_with_delimiter(@book.word_count) %> palavras</span>
        </div>

        <% if @book.description.present? %>
          <div class="mt-6">
            <h2 class="text-lg font-semibold text-text-primary mb-2">Sinopse</h2>
            <p class="text-text-secondary leading-relaxed"><%= @book.description %></p>
          </div>
        <% end %>

        <div class="mt-8 flex flex-wrap gap-3">
          <% if @book.published? %>
            <%= link_to read_book_path(@book), class: "inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              Ler Agora
            <% end %>
          <% end %>

          <% if user_signed_in? && @book.user == current_user %>
            <%= link_to write_book_path(@book), class: "inline-flex items-center gap-2 px-4 py-2 bg-[#8B7355] text-white rounded-lg hover:bg-[#7A6548] transition-colors font-medium" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Escrever
            <% end %>

            <%= link_to edit_book_path(@book), class: "inline-flex items-center gap-2 px-4 py-2 bg-bg-main text-text-primary border border-border rounded-lg hover:bg-bg-sec transition-colors font-medium" do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
              Editar
            <% end %>

            <% if @book.published? %>
              <%= link_to unpublish_book_path(@book),
                  data: { turbo_method: :patch, turbo_confirm: "Despublicar este livro?" },
                  class: "inline-flex items-center gap-2 px-4 py-2 bg-warning/10 text-warning border border-warning/20 rounded-lg hover:bg-warning/20 transition-colors font-medium" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                Despublicar
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>