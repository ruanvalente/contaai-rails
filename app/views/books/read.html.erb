<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to book_path(@book), class: "inline-flex items-center gap-2 text-text-secondary hover:text-text-primary transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Voltar para detalhes
    <% end %>
  </div>

  <article class="prose prose-lg max-w-none">
    <h1 class="text-3xl font-serif font-bold text-text-primary mb-4"><%= @book.title %></h1>
    <p class="text-text-secondary mb-8">por <%= @book.author_name %></p>

    <% if @book.content.present? %>
      <div class="font-reading text-lg leading-relaxed text-text-primary">
        <%= sanitize(@book.content, tags: ContentSanitizer::ALLOWED_TAGS, attributes: ContentSanitizer::ALLOWED_ATTRIBUTES) %>
      </div>
    <% else %>
      <div class="text-center py-12 text-text-secondary">
        <p>Conteúdo ainda não disponível.</p>
      </div>
    <% end %>
  </article>
</div>