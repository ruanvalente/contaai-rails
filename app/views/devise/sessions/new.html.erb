<div class="min-h-screen flex">
  <!-- Left side: Form -->
  <div class="flex-1 flex items-center justify-center p-8">
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="mb-8">
        <%= link_to root_path do %>
          <span class="font-serif text-2xl font-bold text-primary">ContaAI</span>
        <% end %>
      </div>

      <!-- Title -->
      <h1 class="text-2xl font-bold text-text-primary mb-2">Bem-vindo de volta</h1>
      <p class="text-text-secondary mb-8">Entre na sua conta para continuar.</p>

      <!-- Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5", data: { turbo: false } }) do |f| %>
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-text-primary mb-1.5" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "w-full pl-10 pr-4 py-3 border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-colors bg-white" %>
          </div>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-text-primary mb-1.5" %>
          <div class="relative" data-controller="password-toggle">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Digite sua senha", class: "w-full pl-10 pr-12 py-3 border border-border rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-colors bg-white", data: { password_toggle_target: "input" } %>
            <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-text-muted hover:text-text-primary transition-colors" data-action="click->password-toggle#toggle">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-password-toggle-target="eyeOff">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
              </svg>
              <svg class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-password-toggle-target="eyeOn">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-primary rounded border-border focus:ring-primary" %>
            <%= f.label :remember_me, "Lembrar-me", class: "text-sm text-text-secondary" %>
          </div>
          <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-sm text-primary hover:text-primary-dark transition-colors font-medium" %>
        </div>

        <div>
          <%= f.submit "Entrar", class: "w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3 rounded-lg transition-all duration-200 cursor-pointer hover:shadow-lg hover:shadow-primary/20 active:scale-[0.98]" %>
        </div>
      <% end %>

      <!-- Separator -->
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-border"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-bg-main text-text-secondary">ou</span>
        </div>
      </div>

      <!-- Google button -->
      <button type="button" class="w-full flex items-center justify-center gap-3 bg-white border border-border hover:border-primary/40 text-text-primary font-medium py-3 rounded-lg transition-all duration-200 hover:shadow-md">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Entrar com Google
      </button>

      <!-- Link cadastro -->
      <div class="mt-6 text-center">
        <span class="text-text-secondary text-sm">Não tem uma conta?</span>
        <%= link_to "Criar conta", new_registration_path(resource_name), class: "text-primary hover:text-primary-dark font-medium text-sm transition-colors ml-1" %>
      </div>
    </div>
  </div>

  <!-- Right side: Illustration -->
  <div class="hidden lg:flex flex-1 bg-bg-contrast items-center justify-center">
    <div class="text-center text-white px-12">
      <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-primary/10 flex items-center justify-center">
        <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>
      <h2 class="font-serif text-3xl font-bold mb-4">Milhares de histórias esperam por você</h2>
      <p class="text-white/70 text-lg max-w-sm mx-auto">Entre na sua conta e continue sua jornada literária.</p>
    </div>
  </div>
</div>
