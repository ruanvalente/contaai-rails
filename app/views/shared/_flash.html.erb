<% if flash[:notice] %>
  <div data-controller="flash" class="fixed top-4 right-4 z-50 bg-success/10 border border-success/30 text-success px-4 py-3 rounded-lg shadow-lg max-w-md transition-all duration-300 translate-x-0 opacity-100">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span><%= flash[:notice] %></span>
    </div>
  </div>
<% end %>

<% if flash[:alert] %>
  <div data-controller="flash" class="fixed top-4 right-4 z-50 bg-error/10 border border-error/30 text-error px-4 py-3 rounded-lg shadow-lg max-w-md transition-all duration-300 translate-x-0 opacity-100">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <span><%= flash[:alert] %></span>
    </div>
  </div>
<% end %>
