<div class="max-w-6xl mx-auto">
  <div class="mb-8">
    <h1 class="text-2xl font-serif font-bold text-text-primary mb-2">Favoritos</h1>
    <p class="text-text-secondary">Livros marcados como favoritos.</p>
  </div>

  <% if @books.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @books.each do |book| %>
        <%= link_to book_path(book), class: "group block" do %>
          <div class="bg-bg-card rounded-xl border border-border-light shadow-sm overflow-hidden hover:shadow-md transition-all duration-200 group-hover:-translate-y-1">
            <div class="aspect-[3/4] bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center relative">
              <% if book.cover_image.attached? %>
                <%= image_tag book.cover_image.variant(resize_to_fill: [300, 400]), class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-24 h-32 rounded shadow-lg flex items-center justify-center" style="background-color: <%= book.cover_color %>">
                  <span class="text-white text-lg font-bold"><%= book.title.first(2) %></span>
                </div>
              <% end %>
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-text-primary truncate group-hover:text-primary transition-colors"><%= book.title %></h3>
              <p class="text-sm text-text-secondary truncate"><%= book.author_name %></p>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-xs text-text-muted"><%= book.category.humanize %></span>
                <% if book.average_rating > 0 %>
                  <span class="text-xs text-warning">★ <%= book.average_rating %></span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12 bg-bg-card rounded-xl border border-border-light">
      <div class="w-16 h-16 mx-auto mb-4 bg-primary/10 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </div>
      <h3 class="text-lg font-semibold text-text-primary mb-2">Nenhum favorito</h3>
      <p class="text-text-secondary mb-4">Marque livros como favoritos para encontrá-los facilmente.</p>
      <%= link_to explore_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium" do %>
        Explorar Livros
      <% end %>
    </div>
  <% end %>
</div>