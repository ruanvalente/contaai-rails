<% if books.any? %>
  <div class="max-h-96 overflow-y-auto">
    <% books.each do |book| %>
      <%= link_to book_path(book), class: "flex items-center gap-3 px-4 py-3 hover:bg-bg-sec transition-colors" do %>
        <div class="w-10 h-14 bg-gradient-to-br from-primary/20 to-primary/5 rounded flex-shrink-0 flex items-center justify-center">
          <% if book.cover_image.attached? %>
            <%= image_tag book.cover_image.variant(resize_to_fill: [40, 56]), class: "w-full h-full object-cover rounded" %>
          <% else %>
            <span class="text-xs font-medium text-primary"><%= book.title.first(2) %></span>
          <% end %>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-text-primary truncate"><%= book.title %></p>
          <p class="text-xs text-text-secondary truncate"><%= book.author_name %></p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="px-4 py-6 text-center text-text-secondary text-sm">
    Nenhum livro encontrado para "<%= @query %>"
  </div>
<% end %>