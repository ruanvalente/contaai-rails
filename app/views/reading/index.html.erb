<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <h1 class="text-2xl font-serif font-bold text-text-primary mb-2">Minha Sessão</h1>
    <p class="text-text-secondary">Continue de onde parou.</p>
  </div>

  <% if user_signed_in? %>
    <% reading_progresses = current_user.reading_progresses.includes(:book).where(status: [:in_progress, :completed]).order(updated_at: :desc).limit(10) %>
    <% if reading_progresses.any? %>
      <div class="space-y-4">
        <% reading_progresses.each do |progress| %>
          <div class="bg-bg-card rounded-xl border border-border-light shadow-sm p-4 flex items-center gap-4">
              <div class="w-16 h-22 bg-gradient-to-br from-primary/20 to-primary/5 rounded flex-shrink-0 flex items-center justify-center" style="background-color: <%= progress.book.cover_color %>">
                <% if progress.book.cover_image.attached? %>
                  <%= image_tag progress.book.cover_image.variant(resize_to_fill: [64, 88]), class: "w-full h-full object-cover rounded" %>
                <% else %>
                  <span class="text-sm font-medium text-primary"><%= progress.book.title.first(2) %></span>
                <% end %>
              </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-text-primary truncate"><%= progress.book.title %></h3>
              <p class="text-sm text-text-secondary truncate"><%= progress.book.author_name %></p>
              <div class="mt-2 flex items-center gap-2">
                <div class="flex-1 bg-bg-sec rounded-full h-2">
                  <div class="bg-primary h-2 rounded-full" style="width: <%= progress.percentage %>%"></div>
                </div>
                <span class="text-xs text-text-muted"><%= progress.percentage %>%</span>
              </div>
            </div>
            <%= link_to read_book_path(progress.book), class: "px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium" do %>
              Continuar
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-bg-card rounded-xl border border-border-light">
        <div class="w-16 h-16 mx-auto mb-4 bg-primary/10 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-text-primary mb-2">Nenhuma leitura em andamento</h3>
        <p class="text-text-secondary mb-4">Comece a ler um livro para acompanhar seu progresso.</p>
        <%= link_to explore_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium" do %>
          Explorar Livros
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12 bg-bg-card rounded-xl border border-border-light">
      <div class="w-16 h-16 mx-auto mb-4 bg-primary/10 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </div>
      <h3 class="text-lg font-semibold text-text-primary mb-2">Faça login para continuar</h3>
      <p class="text-text-secondary mb-4">Acesse sua conta para acompanhar suas leituras.</p>
      <%= link_to new_user_session_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-medium" do %>
        Entrar
      <% end %>
    </div>
  <% end %>
</div>